# Ignore the node_modules folder inside the backend directory
node_modules/

# Ignore environment variable files (if you're using .env)
.env

# Ignore build or compiled files (if you have them)
dist/
build/

# Ignore IDE or editor-specific files
.vscode/
.idea/

# Ignore logs and other temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore system files (macOS, Windows, etc.)
.DS_Store       # macOS system file
Thumbs.db       # Windows system file
